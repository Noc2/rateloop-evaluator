{
  "$defs": {
    "CaseInput": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "context": {
          "default": "",
          "maxLength": 100000,
          "title": "Context",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "maxLength": 100000,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CaseInput",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "Label",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/Label"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Labels",
          "type": "array"
        },
        "passLabels": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Passlabels",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "labels"
      ],
      "title": "Question",
      "type": "object"
    },
    "Template": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "language": {
          "enum": [
            "en",
            "de"
          ],
          "title": "Language",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        },
        "maxTokens": {
          "default": 512,
          "maximum": 8192,
          "minimum": 32,
          "title": "Maxtokens",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "language",
        "questions"
      ],
      "title": "Template",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "rateloop.evaluator.request.v1",
      "default": "rateloop.evaluator.request.v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "workspaceId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Workspaceid",
      "type": "string"
    },
    "caseId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Caseid",
      "type": "string"
    },
    "idempotencyKey": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$",
      "title": "Idempotencykey",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/Template"
    },
    "input": {
      "$ref": "#/$defs/CaseInput"
    },
    "modelBundleId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Modelbundleid",
      "type": "string"
    },
    "deadlineMs": {
      "default": 5000,
      "maximum": 60000,
      "minimum": 1,
      "title": "Deadlinems",
      "type": "integer"
    }
  },
  "required": [
    "workspaceId",
    "caseId",
    "idempotencyKey",
    "template",
    "input",
    "modelBundleId"
  ],
  "title": "EvaluationRequest",
  "type": "object"
}
