<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>ai.rateloop.evaluator</string>
  <key>ProgramArguments</key><array>
    <string>/REPLACE/rateloop-evaluator/.venv/bin/rateloop-evaluator</string>
    <string>--state-dir</string><string>/REPLACE/private-evaluator-state</string>
    <string>serve</string><string>--bundle-id</string><string>gliner25-multi-shadow-v1</string>
    <string>--device</string><string>mps</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
</dict></plist>
